# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3000

# Clave secreta para los tokens de sesión (cambiá esto por una clave larga y aleatoria)
JWT_SECRET=cambia_esto_por_algo_secreto_largo_2024

# Usuario y contraseña del panel admin
ADMIN_USER=admin

# Para generar el hash de tu contraseña, corrés: node -e "require('bcryptjs').hash('TU_CONTRASEÑA',10).then(console.log)"
# Ejemplo con contraseña "garci2024":
ADMIN_PASS_HASH=$2a$10$ejemplo_hash_aqui_reemplaza_este

# Cloudinary (para subir imágenes) - creá cuenta gratis en cloudinary.com
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
